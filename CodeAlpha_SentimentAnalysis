import pandas as pd
import numpy as np
url = 'https://raw.githubusercontent.com/justmarkham/DAT4/master/data/rt_critics.csv'
df = pd.read_csv(url)  # 2000+ movie reviews with ratings

# Create sentiment labels from ratings
def classify_sentiment(rating):
    if rating <= 2: return 'negative'
    elif rating == 3: return 'neutral' 
    else: return 'positive'

df['sentiment'] = df['critic_score'].apply(classify_sentiment)
print(df.sentiment.value_counts())
# Output: positive: 776, negative: 533, neutral: 691

import nltk
from nltk.sentiment.vader import SentimentIntensityAnalyzer
nltk.download('vader_lexicon')

# VADER detects emotions + compound score
analyzer = SentimentIntensityAnalyzer()
df['vader_scores'] = df['fresh'].apply(lambda x: analyzer.polarity_scores(str(x)))

# Extract emotions
df['compound'] = df['vader_scores'].apply(lambda x: x['compound'])
df['emotion'] = df['compound'].apply(lambda x: 'positive' if x >= 0.05 else ('negative' if x <= -0.05 else 'neutral'))

# For social media (Req #3)
